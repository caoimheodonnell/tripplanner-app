{
  "expo": {
    "name": "TripPlanner",
    "slug": "TripPlanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Trip Planner.png",
    "scheme": "tripplanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TripPlanner"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b5efba5-c4ac-4d58-b33b-ed9c4b3adb4c"
      }
    },
    "owner": "caoimheodonnell",
"runtimeVersion": {
  "policy": "sdkVersion"
},
"updates": {
  "url": "https://u.expo.dev/5b5efba5-c4ac-4d58-b33b-ed9c4b3adb4c"
}
  }
}
    

